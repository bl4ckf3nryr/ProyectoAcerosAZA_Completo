{
  "info": {
    "name": "Aceros AZA — API Monitoreo y Trazabilidad del Trefilado",
    "description": "Colección completa de endpoints REST para pruebas con Postman, Newman y k6.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "serviceToken",
      "value": "AZA-TREFILADO-SERVICE-TOKEN-2026",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Autenticación (CU1)",
      "item": [
        {
          "name": "POST /api/auth/login (Admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre_usuario\": \"admin\",\n  \"password\": \"admin123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "POST /api/auth/login (Supervisor)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre_usuario\": \"supervisor\",\n  \"password\": \"super123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "POST /api/auth/login (Operador)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre_usuario\": \"operador1\",\n  \"password\": \"oper123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "GET /api/auth/me",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/auth/me", "host": ["{{baseUrl}}"], "path": ["api", "auth", "me"] }
          }
        }
      ]
    },
    {
      "name": "2. Inspecciones (CU2, CU3, CU4)",
      "item": [
        {
          "name": "GET /api/inspecciones/ultimo (Vista Operador CU3)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/inspecciones/ultimo", "host": ["{{baseUrl}}"], "path": ["api", "inspecciones", "ultimo"] }
          }
        },
        {
          "name": "POST /api/inspecciones (Vía Token de Servicio - Máquina)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-service-token", "value": "{{serviceToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"angulo\": 13.25,\n  \"id_lote\": 50,\n  \"id_batch\": 200,\n  \"id_receta\": 1\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/inspecciones", "host": ["{{baseUrl}}"], "path": ["api", "inspecciones"] }
          }
        },
        {
          "name": "GET /api/inspecciones (Histórico con Filtros Combinables CU4)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/inspecciones?page=1&limit=20&estado=rechazado",
              "host": ["{{baseUrl}}"],
              "path": ["api", "inspecciones"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" },
                { "key": "estado", "value": "rechazado" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "3. Observaciones (CU6)",
      "item": [
        {
          "name": "POST /api/observaciones (Append-only RNF06)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id_inspeccion\": 2000,\n  \"texto\": \"Ajuste de troquel y cono de reducción por variación de ángulo.\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/observaciones", "host": ["{{baseUrl}}"], "path": ["api", "observaciones"] }
          }
        },
        {
          "name": "GET /api/observaciones",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/observaciones", "host": ["{{baseUrl}}"], "path": ["api", "observaciones"] }
          }
        }
      ]
    },
    {
      "name": "4. Dashboard (RF06)",
      "item": [
        {
          "name": "GET /api/dashboard/summary (KPIs)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/dashboard/summary", "host": ["{{baseUrl}}"], "path": ["api", "dashboard", "summary"] }
          }
        },
        {
          "name": "GET /api/dashboard/trend (Tendencia)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/dashboard/trend", "host": ["{{baseUrl}}"], "path": ["api", "dashboard", "trend"] }
          }
        },
        {
          "name": "GET /api/dashboard/by-recipe (Producción Recetas)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/dashboard/by-recipe", "host": ["{{baseUrl}}"], "path": ["api", "dashboard", "by-recipe"] }
          }
        }
      ]
    },
    {
      "name": "5. Base de Datos Embebida (Admin)",
      "item": [
        {
          "name": "GET /api/database/tables",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/database/tables", "host": ["{{baseUrl}}"], "path": ["api", "database", "tables"] }
          }
        },
        {
          "name": "POST /api/database/query (Sandbox Seguro)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"SELECT estado, COUNT(*) as total FROM INSPECCION GROUP BY estado;\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/database/query", "host": ["{{baseUrl}}"], "path": ["api", "database", "query"] }
          }
        }
      ]
    }
  ]
}
