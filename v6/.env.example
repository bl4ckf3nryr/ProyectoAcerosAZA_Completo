# ============================================
# Configuración del Sistema de Trefilado
# Aceros AZA — ES2 INACAP
# ============================================

# Puerto del servidor backend
PORT=3000

# Entorno de ejecución (development | production)
NODE_ENV=development

# Secreto para firma de tokens JWT
# ⚠️ CAMBIAR EN PRODUCCIÓN por un valor seguro y único
JWT_SECRET=aza-trefilado-jwt-secret-2026-cambiar-en-produccion

# Tiempo de expiración del token JWT (en horas)
JWT_EXPIRES_IN=8

# Token de servicio para el simulador/telemetría industrial
# Usado por el endpoint POST /api/inspecciones con cabecera x-service-token
SERVICE_TOKEN=AZA-TREFILADO-SERVICE-TOKEN-2026

# Ruta al archivo de base de datos SQLite
DB_PATH=./db/trefilado.db

# Origen permitido para CORS (URL del frontend en producción)
CORS_ORIGIN=http://localhost:5173

# Nivel de logging (debug | info | warn | error)
LOG_LEVEL=info
